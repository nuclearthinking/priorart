# Copy this file to ~/.priorart/priorart.env. Priorart deliberately does not
# load a project-local .env because MCP clients may start from any directory.

# Derived per-worktree indexes and the shared coordinator socket.
PRIORART_INDEX_DIR=~/.priorart/indexes
# PRIORART_DAEMON_SOCKET=~/.priorart/daemon.sock
PRIORART_WATCH_INTERVAL=2.0
PRIORART_SEARCH_DEADLINE_SECONDS=15.0
PRIORART_CANDIDATE_LIMIT=50

# Optional shared provider. Leave every model blank for lexical-only search.
PRIORART_BASE_URL=
PRIORART_API_KEY=

# Service-specific settings override the shared provider above. Base URLs
# normally include the provider API prefix, such as /v1.
PRIORART_LLM_BASE_URL=
PRIORART_LLM_API_KEY=
PRIORART_LLM_MODEL=

PRIORART_EMBED_BASE_URL=
PRIORART_EMBED_API_KEY=
PRIORART_EMBED_MODEL=
PRIORART_EMBED_DIM=1024
PRIORART_EMBED_INPUT_FORMAT=instruct-text

PRIORART_RERANK_BASE_URL=
PRIORART_RERANK_API_KEY=
PRIORART_RERANK_MODEL=
PRIORART_RERANK_PROTOCOL=openai
PRIORART_RERANK_QUERY_FORMAT=instruct
