# Configuration is read from PRIORART_* environment variables, then from a
# project-local .env (this file, copy and fill in), then from
# ~/.priorart/priorart.env. Real environment variables win over both files;
# the project-local .env wins over the home file.

# Use PRIORART_BASE_URL/API_KEY when one provider serves every endpoint.
PRIORART_BASE_URL=
PRIORART_API_KEY=

# Service-specific values override the shared provider above. Base URLs should
# include the provider's API prefix, commonly /v1.
PRIORART_LLM_BASE_URL=
PRIORART_LLM_API_KEY=
PRIORART_LLM_MODEL=

PRIORART_EMBED_BASE_URL=
PRIORART_EMBED_API_KEY=
PRIORART_EMBED_MODEL=
PRIORART_EMBED_DIM=1024

PRIORART_RERANK_BASE_URL=
PRIORART_RERANK_API_KEY=
PRIORART_RERANK_MODEL=

# PRIORART_DB=~/.priorart/index.db
